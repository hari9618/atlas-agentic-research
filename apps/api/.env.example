# ============================================================
#  Atlas — Autonomous Due-Diligence Desk : environment config
#  Copy to apps/api/.env and fill in. Everything has a safe default
#  EXCEPT GROQ_API_KEY, which the LLM needs.
# ============================================================

# ---- LLM (Groq) -------------------------------------------
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# cheaper/faster model for memory-summarizer + LLM-Ops eval/optimizer
SUMMARIZER_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
# larger, separate budget for the synthesizer's structured investor brief
SYNTH_MAX_TOKENS=3500

# ---- Human review -----------------------------------------
# Cap on the human-feedback -> regenerate loop.
MAX_REVISIONS=3

# ---- Persistence (Postgres, optional) ---------------------
# Durable LangGraph checkpoints (paused human-review runs), episodic memory and
# the prompt registry. Blank -> local SQLite/JSON under data/cache (fine for dev,
# but wiped on every deploy on ephemeral hosts like Render's free tier).
# If set but unreachable, Atlas logs a warning and falls back to SQLite.
# postgres:// and postgresql:// are both accepted. Examples:
#   docker compose : postgresql://atlas:atlas_dev_pw@localhost:5433/atlas
#   Neon           : postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require
#   Supabase       : postgresql://postgres.REF:PASS@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
#   Render         : use the "Internal Database URL" (same region, no sslmode needed)
DATABASE_URL=

# ---- Security ---------------------------------------------
# Encryption at rest for sensitive columns (emails, run state, feedback, memories).
# REQUIRED in production (the API refuses to start without it). Generate with:
#   python -m atlas.security.crypto
# Keep it in the host's secret store, never in the database or git.
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=k1
# During a key rotation only: retired keys kept for decryption ("k0:<key>,...").
DATA_ENCRYPTION_KEYS_PREVIOUS=
# Access-token signing key (>= 32 random chars). Blank -> a key generated once and
# stored in the database (works, but set it explicitly in production).
AUTH_JWT_SECRET=
AUTH_ACCESS_TTL_S=900
AUTH_REFRESH_TTL_DAYS=30
# Comma-separated emails that get the admin role (run experiments, edit the corpus,
# read the audit log). Promotion happens at sign-up / next sign-in.
AUTH_ADMIN_EMAILS=
AUTH_ALLOW_SIGNUP=true
AUTH_ALLOW_GUEST=true

# ---- Scale-out ---------------------------------------------
# Shared store for rate limits + run leases across instances (Render Key Value,
# Upstash, or the compose redis). Blank -> Postgres, else per-process memory.
REDIS_URL=
RATE_LIMITS_ENABLED=true
# Research runs one instance streams at once (beyond: 503 + Retry-After).
MAX_CONCURRENT_RUNS=4
# Parallel LLM calls per instance (bulkhead in front of the provider).
MAX_CONCURRENT_LLM_CALLS=6

# ---- Memory -----------------------------------------------
# Run the summarizer (consolidate episodes -> semantic facts) every N runs.
MEMORY_CONSOLIDATE_EVERY=3

# ---- Observability (Langfuse) -----------------------------
# Self-hosted via docker-compose (LANGFUSE_HOST below) OR Langfuse Cloud.
# For Cloud, set the correct region host: https://us.cloud.langfuse.com
# or https://eu.cloud.langfuse.com  (plain cloud.langfuse.com will 401 if
# your keys are in a different region). Leave keys blank to disable tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# ---- Vector store (Qdrant) --------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=atlas_corpus

# ---- Embeddings (free / local) ----------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-base

# ---- External tools (MCP) — all optional / free tiers -----
TAVILY_API_KEY=
SEC_EDGAR_USER_AGENT=atlas-research you@example.com

# ---- App ---------------------------------------------------
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
